# CLion
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#cmake-build-*

# ---- Python / this project ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Run artifacts (regenerate with `python -m rsv.cli all`).
# The few figures the README shows are copied into docs/figures/ and committed;
# everything else here is reproducible from the seed in configs/default.yaml.
results/
!results/.gitkeep
data/
*.npz
!docs/figures/*.png
